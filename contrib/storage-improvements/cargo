#!/usr/bin/env bash
set -euo pipefail
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd -- "$script_dir/../.." && pwd)
if [[ $(uname -s) == Darwin ]]; then
    exec msl --distribution "${MSL_DISTRO:-Dev}" --cd "/mnt/macos$repo_root" \
        --exec bash "/mnt/macos$script_dir/cargo" "$@"
fi
cd -- "$repo_root"
export CARGO_TARGET_DIR=${ZENOH_FORK_TARGET_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/zenoh-fork/target}
export CARGO_PROFILE_DEV_DEBUG=0
export CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-4}
exec "$HOME/.cargo/bin/cargo" "$@"
